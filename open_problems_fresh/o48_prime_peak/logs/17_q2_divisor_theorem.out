    d= 4: φ(88/4) = φ(22) = 10, /2 = 5
    d= 8: φ(88/8) = φ(11) = 10, /2 = 5
    d=11: φ(88/11) = φ(8) = 4, /2 = 2
    d=22: φ(88/22) = φ(4) = 2, /2 = 1
    d=44: φ(88/44) = φ(2) = 1, /2 = 1
