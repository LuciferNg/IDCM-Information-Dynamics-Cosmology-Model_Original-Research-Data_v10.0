#!/usr/bin/env python3
"""
13b_node45_multiscale_fast.py — Node 45 深度分析 (快速版)
==========================================================
紅燈 2: node 45 (+1.57 μK @ b=-8.4°) 係咪銀河前景假象?

策略: 只做 4 個關鍵尺度 (0.5°, 2.0°, 4.17°, 10°), 三地圖
加埋 node 45 附近區域結構
"""
import healpy as hp
import numpy as np
import math
from astropy.coordinates import SkyCoord
import astropy.units as u
import os

BASE = "/home/wsl/Projects/IDCM/IDCM-v10.0/open_problems_fresh"

nodes = []
with open(f"{BASE}/cmb_cold_spot/data/a5_nodes.txt") as f:
    for line in f:
        ra, dec = map(float, line.split())
        nodes.append((ra, dec))
nodes = np.array(nodes)
sc = SkyCoord(ra=nodes[:, 0]*u.deg, dec=nodes[:, 1]*u.deg, frame='icrs')
gal = sc.galactic

# 載入三地圖 (RING)
maps = {}
maps['SMICA'] = hp.read_map('/tmp/smica2.fits')
mn = hp.read_map('/tmp/nilc.fits', field=0, nest=True)
maps['NILC'] = hp.reorder(mn, n2r=True)
mc = hp.read_map('/tmp/commander.fits', field=0, nest=True)
maps['Commander'] = hp.reorder(mc, n2r=True)
nside = hp.get_nside(maps['SMICA'])

print("=== Node 45 多尺度三地圖 (快速) ===")
print(f"Node 45: l={gal.l.deg[45]:.2f}, b={gal.b.deg[45]:.2f}")
print()

# 4 個關鍵尺度
scales = [0.5, 2.0, 4.17, 10.0]
print(f"{'尺度':<7}{'SMICA':<12}{'NILC':<12}{'Commander':<12}{'max|Δ|'}")
for fw in scales:
    sigma = np.radians(fw) / (2 * np.sqrt(2 * np.log(2)))
    vals = []
    for name, m in maps.items():
        ms = hp.remove_dipole(hp.smoothing(m, sigma=sigma))
        pix = hp.ang2pix(nside, gal.l.deg[45], gal.b.deg[45], lonlat=True)
        vals.append(ms[pix]*1e6)
    spread = max(abs(vals[i]-vals[j]) for i in range(3) for j in range(i+1, 3))
    print(f"{fw:>5.2f}°  {vals[0]:+9.2f}  {vals[1]:+9.2f}  {vals[2]:+9.2f}  {spread:6.2f}")

# 對比: 全 60 節點 spread (4.17°)
print("\n=== 全 60 節點三地圖 spread (4.17°) ===")
sigma = np.radians(4.17) / (2 * np.sqrt(2 * np.log(2)))
all_vals = {}
for name, m in maps.items():
    ms = hp.remove_dipole(hp.smoothing(m, sigma=sigma))
    pix_all = hp.ang2pix(nside, gal.l.deg, gal.b.deg, lonlat=True)
    all_vals[name] = ms[pix_all]*1e6
spreads = np.array([max(abs(all_vals['SMICA'][i]-all_vals['NILC'][i]),
                        abs(all_vals['SMICA'][i]-all_vals['Commander'][i]),
                        abs(all_vals['NILC'][i]-all_vals['Commander'][i])) for i in range(60)])
print(f"Node 45 spread: {spreads[45]:.2f} μK")
print(f"全 60 節點: mean={spreads.mean():.2f}, std={spreads.std():.2f}, max={spreads.max():.2f}")
print(f"Node 45 百分位: {(spreads < spreads[45]).mean()*100:.0f}%")

# Node 45 附近區域 (4.17° 平滑, SMICA)
print("\n=== Node 45 附近 10° 區域 (SMICA 4.17°) ===")
ms = hp.remove_dipole(hp.smoothing(maps['SMICA'], sigma=sigma))
v45 = np.array([math.cos(math.radians(nodes[45,1]))*math.cos(math.radians(nodes[45,0])),
                math.cos(math.radians(nodes[45,1]))*math.sin(math.radians(nodes[45,0])),
                math.sin(math.radians(nodes[45,1]))])
n64 = 64
m_low = hp.ud_grade(ms, n64)
disc = hp.query_disc(n64, v45, np.radians(10))
vals_disc = m_low[disc]*1e6
pix45 = hp.ang2pix(n64, gal.l.deg[45], gal.b.deg[45], lonlat=True)
print(f"10° 內像素: {len(disc)}, mean={vals_disc.mean():+.2f}, std={vals_disc.std():.2f}")
print(f"範圍: [{vals_disc.min():+.1f}, {vals_disc.max():+.1f}]")
print(f"Node 45: {m_low[pix45]*1e6:+.2f} vs 區域 mean {vals_disc.mean():+.2f}")

# 對照: 其他 ΔE=0 節點附近結構
print("\n=== 其他 ΔE=0 節點附近 10° (對照) ===")
ZERO_E = {10, 12, 19, 22, 23, 25, 28, 32, 37, 40, 45, 46}
for i in sorted(ZERO_E - {45}):
    v = np.array([math.cos(math.radians(nodes[i,1]))*math.cos(math.radians(nodes[i,0])),
                  math.cos(math.radians(nodes[i,1]))*math.sin(math.radians(nodes[i,0])),
                  math.sin(math.radians(nodes[i,1]))])
    d = hp.query_disc(n64, v, np.radians(10))
    vd = m_low[d]*1e6
    pi = hp.ang2pix(n64, gal.l.deg[i], gal.b.deg[i], lonlat=True)
    print(f"  #{i}: node={m_low[pi]*1e6:+6.2f} 區域mean={vd.mean():+6.2f} std={vd.std():5.2f}")

print("\nDONE")
